# proxmox settings
proxmox_endpoint  = "https://192.168.1.100:8006/"
proxmox_api_token = "root@pam!terraform=00000000-0000-0000-0000-000000000000"
proxmox_insecure  = true

# proxmox agent
proxmox_agent = true

# ssh settings
proxmox_user     = "root"
private_key      = "~/.ssh/id_ed25519"
node_name        = "pve"
node_address     = "192.168.1.100"
node_port        = 22
datastore_id     = "local-lvm"
iso_datastore_id = "local"

# general settings
vm_dns_list = ["1.1.1.1", "8.8.8.8"]

# vm ssh settings
vm_user_account = "ubuntu"
vm_user_key     = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyContentPlaceholderForExampleFile user@terraform-node"

# default settings template
vm_id_template         = 9000
default_cpu_cores      = 2
default_memory_mb      = 2048
disk_size_gb           = 20
interface              = "virtio0"
default_address        = "dhcp"
default_network_bridge = "vmbr0"

# vm settings 1
vm_id_1              = 101
vm_id_1_name         = "app-node-01"
tags_vm1             = ["terraform", "web"]
vm_id_1_cpu          = 2
vm_id_1_memory       = 2048
vm_id_1_floating     = 0
vm_id_1_datastore_id = "local-lvm"
vm_id_1_disksize     = 20
vm_id_1_address      = "192.168.1.101/24"
vm_id_1_gateway      = "192.168.1.1"

# vm settings 2
vm_id_2              = 102
vm_id_2_name         = "db-node-01"
tags_vm2             = ["terraform", "database"]
vm_id_2_cpu          = 4
vm_id_2_memory       = 4096
vm_id_2_floating     = 0
vm_id_2_datastore_id = "local-lvm"
vm_id_2_disksize     = 40
vm_id_2_address      = "192.168.1.102/24"
vm_id_2_gateway      = "192.168.1.1"

# vm settings 3
vm_id_3              = 102
vm_id_3_name         = "db-node-01"
tags_vm3             = ["terraform", "database"]
vm_id_3_cpu          = 4
vm_id_3_memory       = 4096
vm_id_3_floating     = 0
vm_id_3_datastore_id = "local-lvm"
vm_id_3_disksize     = 40
vm_id_3_address      = "192.168.1.102/24"
vm_id_3_gateway      = "192.168.1.1"